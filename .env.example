# ---------------------------------------------------------------------------
# WordWatch configuration
#
# Copy this file to `.env` and fill in your bot token:  cp .env.example .env
#
# DISCORD_TOKEN is the only required setting. Every other line below is
# commented out and shows the built-in default: uncomment one only to change it.
# Real environment variables always take precedence over this file, so
# `WORDWATCH_SAVE_FREQUENCY=60 python main.py` and container/systemd variables
# override whatever is written here.
# ---------------------------------------------------------------------------

# REQUIRED. Bot token from the Discord Developer Portal (Bot -> Reset Token).
# Never commit a real token: .env is gitignored, this file is not.
DISCORD_TOKEN=your_discord_bot_token_here


# --- Data files ------------------------------------------------------------
# Relative paths resolve against the directory the bot is started from.
# Each file is written atomically (via a `.tmp` file), so a crash cannot
# truncate them.

# Watched words, filters and alert timestamps, per user and server.
#WORDWATCH_USER_WORDS_FILE=userwords.json

# Per-user notification cooldowns, in seconds.
#WORDWATCH_USER_CDS_FILE=usercds.json

# Swear counts, per server and user.
#WORDWATCH_SWEAR_COUNTS_FILE=swearcounts.json

# Location of each server's live /swearboard message.
#WORDWATCH_LEADERBOARDS_FILE=leaderboards.json

# Tracked swear words, one per line.
#WORDWATCH_SWEAR_WORDS_FILE=swear_words.txt

# Cached fingerprint of the slash-command set. Used to skip the global command
# sync on startup unless a command's name, description, or options changed.
#WORDWATCH_SYNC_STATE_FILE=.command_sync.json


# --- Appearance ------------------------------------------------------------

# Thumbnail shown on /help and on watched-word alerts.
#WORDWATCH_ALERT_THUMBNAIL_URL=https://raw.githubusercontent.com/pixeltopic/WordWatch/master/alertimage.gif


# --- Saving ----------------------------------------------------------------

# Seconds between periodic autosaves of all bot data. Minimum 1.
#WORDWATCH_SAVE_FREQUENCY=900

# Seconds between debounced swear-count saves. Swears are counted in memory
# immediately and written at most this often. 0 saves on every swear.
#WORDWATCH_SWEAR_SAVE_FREQUENCY=30


# --- Behaviour -------------------------------------------------------------

# Minimum seconds between edits of a server's live /swearboard message.
# Discord rate-limits message edits; lower values on a busy server risk 429s.
#WORDWATCH_LEADERBOARD_UPDATE_FREQUENCY=30

# Default alert cooldown in minutes for users who have never run /cd.
# Accepts decimals, e.g. 0.5 for thirty seconds.
#WORDWATCH_DEFAULT_COOLDOWN_MINUTES=15

# Shortest word /watchword will accept. Very short words match constantly.
#WORDWATCH_MIN_WATCHWORD_LENGTH=3

# Truncation limit for the "Content" field of an alert embed.
# Discord rejects embed fields longer than 1024 characters, which is the cap.
#WORDWATCH_ALERT_CONTENT_MAX_CHARS=1000

# Words listed per page by /watched.
#WORDWATCH_WATCHED_PAGE_SIZE=50

# Largest accepted /swearimport attachment, in bytes (1000000 = 1 MB).
#WORDWATCH_MAX_IMPORT_BYTES=1000000

# Set to 1 to force a global slash-command sync on the next startup, ignoring
# the cached fingerprint.
#WORDWATCH_FORCE_SYNC=0
